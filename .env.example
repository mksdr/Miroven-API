# Development only. For Compose: copy to .env and run docker compose up --build.
MIROVEN_ENVIRONMENT=development
MIROVEN_DATABASE_URL=postgresql+psycopg://miroven:miroven_dev@127.0.0.1:5432/miroven
# Generate for deployment: python -c "import secrets; print(secrets.token_hex(32))"
MIROVEN_SECRET_KEY=development-only-change-before-deploying-000000000000
MIROVEN_PUBLIC_ORIGIN=http://localhost:8000
# Optional separate API origin; defaults to PUBLIC_ORIGIN.
# MIROVEN_API_ORIGIN=http://localhost:8000
MIROVEN_SMTP_HOST=127.0.0.1
MIROVEN_SMTP_PORT=1025
MIROVEN_SMTP_FROM=Miroven <noreply@localhost>
MIROVEN_SMTP_STARTTLS=false
MIROVEN_STORAGE_BACKEND=local
MIROVEN_BLOB_DIRECTORY=data/blobs
MIROVEN_BLOB_MAX_BYTES=4194304
MIROVEN_STORAGE_QUOTA_BYTES=104857600
# Optional Pro subscription limits and comma-separated admin emails for /admin.
# MIROVEN_PRO_BLOB_MAX_BYTES=16777216
# MIROVEN_PRO_STORAGE_QUOTA_BYTES=5368709120
# MIROVEN_PRO_MAX_ENTRIES=100000
# MIROVEN_ADMIN_EMAILS=admin@example.com
# S3: set STORAGE_BACKEND=s3 and supply an existing private bucket.
# MIROVEN_S3_BUCKET=miroven-private
# MIROVEN_S3_REGION=us-east-1
# MIROVEN_S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.example
# MIROVEN_S3_ACCESS_KEY=
# MIROVEN_S3_SECRET_KEY=
