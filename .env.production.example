# Copy to .env.production; never commit real values.
# Use URL-safe random hex passwords; keep the DB URL password identical.
MIROVEN_API_IMAGE=miroven-api:0.1.0
MIROVEN_WEB_IMAGE=miroven-web:0.1.0
MIROVEN_DOMAIN=journal.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
MIROVEN_ENVIRONMENT=production
MIROVEN_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
MIROVEN_PUBLIC_ORIGIN=https://journal.example.com
MIROVEN_DATABASE_URL=postgresql+psycopg://miroven:REPLACE_WITH_RANDOM_HEX@db:5432/miroven
MIROVEN_SMTP_HOST=smtp.example.com
MIROVEN_SMTP_PORT=587
MIROVEN_SMTP_FROM=Miroven <noreply@example.com>
MIROVEN_SMTP_USERNAME=REPLACE
MIROVEN_SMTP_PASSWORD=REPLACE
MIROVEN_SMTP_STARTTLS=true
MIROVEN_STORAGE_BACKEND=local
MIROVEN_BLOB_DIRECTORY=/data/blobs
