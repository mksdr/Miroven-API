{
  "services": {
    "db": {
      "image": "postgres:17.11-alpine",
      "command": [
        "postgres",
        "-c",
        "log_statement=none",
        "-c",
        "log_min_error_statement=panic",
        "-c",
        "log_error_verbosity=terse",
        "-c",
        "log_parameter_max_length_on_error=0",
        "-c",
        "log_min_messages=fatal"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "/mnt/tank/miroven/postgres",
          "target": "/var/lib/postgresql/data",
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U miroven -d miroven"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 30
      },
      "restart": "unless-stopped",
      "env_file": [
        {
          "path": "/mnt/tank/miroven/secrets/db.env",
          "format": "raw"
        }
      ],
      "networks": [
        "backend"
      ],
      "stop_grace_period": "60s",
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "migrate": {
      "image": "REPLACE_API_IMAGE",
      "env_file": [
        {
          "path": "/mnt/tank/miroven/secrets/api.env",
          "format": "raw"
        }
      ],
      "environment": {
        "MIROVEN_ENVIRONMENT": "production",
        "MIROVEN_STORAGE_BACKEND": "local",
        "MIROVEN_BLOB_DIRECTORY": "/data/blobs",
        "MIROVEN_TRUSTED_PROXY_IPS": "*"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/mnt/tank/miroven/blobs",
          "target": "/data/blobs",
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "command": [
        "python",
        "-m",
        "app.migrate"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "backend"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s",
      "restart": "no"
    },
    "api": {
      "image": "REPLACE_API_IMAGE",
      "env_file": [
        {
          "path": "/mnt/tank/miroven/secrets/api.env",
          "format": "raw"
        }
      ],
      "environment": {
        "MIROVEN_ENVIRONMENT": "production",
        "MIROVEN_STORAGE_BACKEND": "local",
        "MIROVEN_BLOB_DIRECTORY": "/data/blobs",
        "MIROVEN_TRUSTED_PROXY_IPS": "*"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/mnt/tank/miroven/blobs",
          "target": "/data/blobs",
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/ready', timeout=3)"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 10
      },
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s"
    },
    "worker": {
      "image": "REPLACE_API_IMAGE",
      "env_file": [
        {
          "path": "/mnt/tank/miroven/secrets/api.env",
          "format": "raw"
        }
      ],
      "environment": {
        "MIROVEN_ENVIRONMENT": "production",
        "MIROVEN_STORAGE_BACKEND": "local",
        "MIROVEN_BLOB_DIRECTORY": "/data/blobs",
        "MIROVEN_TRUSTED_PROXY_IPS": "*"
      },
      "volumes": [
        {
          "type": "bind",
          "source": "/mnt/tank/miroven/blobs",
          "target": "/data/blobs",
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "command": [
        "python",
        "-m",
        "app.worker"
      ],
      "depends_on": {
        "migrate": {
          "condition": "service_completed_successfully"
        }
      },
      "restart": "unless-stopped",
      "networks": [
        "backend"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "stop_grace_period": "60s"
    },
    "proxy": {
      "image": "caddy:2.10.2-alpine",
      "volumes": [
        {
          "type": "bind",
          "source": "/mnt/tank/miroven/deploy/Caddyfile",
          "target": "/etc/caddy/Caddyfile",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "networks": [
        "ingress",
        "backend"
      ],
      "depends_on": {
        "api": {
          "condition": "service_healthy"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    },
    "tunnel": {
      "image": "cloudflare/cloudflared:2026.10.0",
      "command": [
        "tunnel",
        "--no-autoupdate",
        "run",
        "--token-file",
        "/run/secrets/tunnel-token"
      ],
      "user": "65532:65532",
      "volumes": [
        {
          "type": "bind",
          "source": "/mnt/tank/miroven/secrets/tunnel-token",
          "target": "/run/secrets/tunnel-token",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "networks": [
        "ingress"
      ],
      "depends_on": {
        "proxy": {
          "condition": "service_started"
        }
      },
      "restart": "unless-stopped",
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "networks": {
    "ingress": {},
    "backend": {}
  }
}
